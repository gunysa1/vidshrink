[Unit]
Description=vidshrink cloud worker (x265)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/vidshrink/.venv/bin/vidshrink pc-worker --config %h/.config/vidshrink/config.toml
# A clean exit (a local fault such as a dead Drive login) is not restarted;
# re-authorize, then start the unit by hand.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
